# IRA CARE deployment: copy to deploy/.env and fill in. Every value is explained in docs/DEPLOY.md.
# Generate secrets with:  python3 -c "import secrets;print(secrets.token_urlsafe(32))"
# Generate the encryption key with:  python3 -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"

IRA_CARE_DOMAIN=care.example.invalid        # the host name that points at this machine; Caddy gets its certificate
IRA_ENVIRONMENT=production                  # production | staging | development (test payments refused in the first two)

POSTGRES_DB=ira_care
POSTGRES_SUPERUSER_PASSWORD=change-me       # the database's own superuser (backups, first-run role creation)
IRA_APP_PASSWORD=change-me                  # ira_app and ira_worker: the runtime roles (row-level security applies)
IRA_MIGRATOR_PASSWORD=change-me             # ira_migrator: applies the migration chain
IRA_MIGRATE_ON_START=true                   # true: the server applies the migration chain each time it starts, on your say-so;
                                            # false: it does not, and you run `docker compose run --rm api migrate` yourself

IRA_SECRET_KEY=change-me                    # signs sessions and tokens
IRA_ADMIN_PASSWORD=change-me                # the private-edition owner account; unused in the cloud edition but required
IRA_CONNECTOR_ENCRYPTION_KEY=change-me      # base64, 32 bytes: seals access notes (and connector credentials)

IRA_CARE_MODEL=ollama                       # ollama (two free open-weight models on this machine, then set questions) | off | fake
IRA_CARE_MODEL_PRIMARY=gemma4:12b           # docs/MODEL_CHOICE.md
IRA_CARE_MODEL_SECONDARY=gemma4:e4b
IRA_CARE_MODEL_KEEP_ALIVE=30m                # the model stays loaded between turns (docs/MODEL_CHOICE.md, round 4)
IRA_CARE_MODEL_NUM_CTX=1024                 # the context window a turn is given
IRA_CARE_INSTANT_ACK=on                     # "I see, Ada." spoken at once while the model composes; off to silence it
IRA_CARE_OPS_PHONE=                         # the operations contact told when the jobs stop (log-only without an SMS provider)
IRA_CARE_SMS_PROVIDER=log                   # log (default) | twilio (needs the Twilio keys; never dials emergency numbers)
IRA_MAIL_TRANSPORT=null                     # null | console | smtp (smtp needs SMTP_HOST etc.; sign-up and invitation mail)
IRA_CLOUD_REGISTRATION_ENABLED=false        # true opens /care/signup
IRA_PAYMENT_PROVIDER=                       # empty (off) | test (development only, with IRA_PAYMENT_TEST_SECRET) | stripe (keys required)

BACKUP_PASSPHRASE=change-me                 # encrypts the nightly backups; without it they cannot be restored
BACKUP_KEEP_DAYS=14
BACKUP_HOUR_UTC=02
