# IRA CARE server and worker image. One image, two commands (see docker-compose.yml).
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1 HF_HUB_OFFLINE=1
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl postgresql-client \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 ira
# The base image's CPython links GNU readline and GDBM (GPL-3.0-or-later) and Berkeley DB 5.3
# (Sleepycat) through three standard-library modules the server never imports (an interactive
# prompt and two on-disk key-value stores). They go, so none of our code links those
# libraries (D-087, docs/security/LICENCES.md); the build fails if one is still importable.
RUN rm -f /usr/local/lib/python3.12/lib-dynload/readline.cpython-312-*.so \
          /usr/local/lib/python3.12/lib-dynload/_gdbm.cpython-312-*.so \
          /usr/local/lib/python3.12/lib-dynload/_dbm.cpython-312-*.so \
    && python -c "import importlib.util as u, sys; sys.exit([m for m in ('readline', '_gdbm', '_dbm') if u.find_spec(m)] or 0)"
WORKDIR /app
# The care server needs the backend's runtime libraries, not the full server's
# model stack (torch, the embedding model): requirements-test.txt is that set.
COPY supracloud-jarvis/ira/requirements-test.txt ./requirements.txt
COPY supracloud-jarvis/ira/requirements-nodeps.txt ./requirements-nodeps.txt
RUN pip install -r requirements.txt psutil==6.1.0 onnxruntime==1.20.1 tokenizers==0.21.0
# faster-whisper without PyAV, whose wheels bundle FFmpeg built with GPL encoders
# (docs/security/LICENCES.md). The build fails if anything brought `av` in anyway.
RUN pip install --no-deps --require-hashes -r requirements-nodeps.txt \
    && python -c "import importlib.util as u, sys; sys.exit('av is installed' if u.find_spec('av') else 0)"
COPY supracloud-jarvis/ira /app
# The small red-flag classifier's public text encoder (Apache-2.0), fetched at build time so
# the running server needs no network for it (docs/MODEL_CHOICE.md).
COPY scripts/training/fetch_encoder.py /tmp/fetch_encoder.py
RUN python /tmp/fetch_encoder.py --dest /app/care/models/encoder && rm /tmp/fetch_encoder.py
COPY supracloud-jarvis/postgres /app/postgres-migrations
# utils/migrations.py looks beside the repository by default; in the image the files are here.
ENV IRA_MIGRATIONS_DIR=/app/postgres-migrations
COPY deploy/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh && chown -R ira:ira /app
USER ira
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 CMD curl -fsS http://127.0.0.1:8000/health || exit 1
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["server"]
