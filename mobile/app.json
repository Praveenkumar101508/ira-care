{
  "expo": {
    "name": "IRA CARE",
    "slug": "ira-care-family",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF8F4"
    },
    "ios": {
      "bundleIdentifier": "care.ira.family",
      "supportsTablet": false,
      "buildNumber": "1",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "IRA CARE tells you when the person you look after needs someone.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "care.ira.family",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "CALL_PHONE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "IRA CARE uses the microphone only while you hold a conversation with IRA, so you can speak instead of typing.",
          "speechRecognitionPermission": "Your phone turns what you say to IRA into text, so you can speak instead of typing. IRA CARE keeps only that text, the same as typing, and no recording."
        }
      ]
    ],
    "extra": {
      "careApiBaseUrl": "http://10.0.2.2:8000",
      "eas": {
        "projectId": "set-when-the-owner-creates-the-project"
      }
    },
    "privacy": "unlisted"
  }
}
