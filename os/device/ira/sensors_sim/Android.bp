//
// IRA CARE OS simulated sensors (E3.c, E3.d, E3.e).
//
// UNBUILT. Soong has never read this file (docs/os/BUILD.md). The signal model,
// sim_signals.cpp, is compiled and tested on the host by
// supracloud-jarvis/ira/tests/readiness/test_os_sensor_sim.py; the HAL service around it is not.
// Not in the product's PRODUCT_PACKAGES: it is for the simulated image only, added on the build
// host as README.md says, never in an image a person wears.
//
// Copyright 2026 IRA CARE. Licensed under the Apache License, Version 2.0.
//

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_binary {
    name: "android.hardware.sensors-service.ira-sim",
    vendor: true,
    relative_install_path: "hw",
    // The init script and the VINTF fragment the framework needs to start and find the service;
    // the version in the fragment must equal the -V<n>-ndk library below (checked by
    // supracloud-jarvis/ira/tests/readiness/test_os_product_layer.py).
    init_rc: ["android.hardware.sensors-service.ira-sim.rc"],
    vintf_fragments: ["android.hardware.sensors-ira-sim.xml"],
    srcs: [
        "sim_signals.cpp",
        "SimSensorsHal.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        // V3 is what the AOSP default sensors service links in Android 15 (hardware/interfaces,
        // sensors/aidl/default/Android.bp, read from a public mirror: os/reference/
        // aosp_reference.json). UNCERTAIN whether the checked-out release has moved to V4.
        "android.hardware.sensors-V3-ndk",
    ],
    cflags: ["-Wall", "-Werror"],
}
