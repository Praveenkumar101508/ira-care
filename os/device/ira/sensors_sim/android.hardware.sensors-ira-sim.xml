<!--
  VINTF manifest fragment for the simulated Sensors HAL (sim image only, never a worn watch).
  The version is the AIDL interface version the service is built against: the same number as
  the "android.hardware.sensors-V<n>-ndk" library in Android.bp, which test_os_product_layer.py
  checks. The AOSP default service declares the same shape (sensors-default.xml).
  UNBUILT (docs/os/BUILD.md). Copyright 2026 IRA CARE. Apache License, Version 2.0.
-->
<manifest version="1.0" type="device">
    <hal format="aidl">
        <name>android.hardware.sensors</name>
        <version>3</version>
        <fqname>ISensors/default</fqname>
    </hal>
</manifest>
