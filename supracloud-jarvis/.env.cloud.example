# =============================================================================
# IRA Cloud — environment template
#
# Copy to `.env` and fill in. EVERY value here is a placeholder; none is a
# working credential and none may be committed filled in.
#
#   cp .env.cloud.example .env
#
# In `staging` and `production` the application VALIDATES this file at startup
# and REFUSES TO START if anything below is still a placeholder, too short, or
# unsafe. See ira/core/runtime/environment.py. That is deliberate: a warning
# about a default admin password is read by a developer on a laptop and by
# nobody at all on an instance that autoscaled up at 3am.
#
# Generate secrets with:  openssl rand -hex 32
# =============================================================================

# ── Environment ──────────────────────────────────────────────────────────────
# One of: development | test | staging | production
# Unset means `development`. A TYPO IS AN ERROR, not a fallback — otherwise
# IRA_ENVIRONMENT=produciton would silently disable every production rule.
IRA_ENVIRONMENT=production

# `private` (single-owner local edition) or `cloud` (multi-tenant).
IRA_EDITION=cloud

# ── Identity ─────────────────────────────────────────────────────────────────
# The public domain. The CORS allowlist is built from it, so a local value here
# is refused in production.
IRA_DOMAIN=
IRA_VERSION=

# ── Secrets — REQUIRED, no defaults, validated at startup ────────────────────
# Signs every JWT. A known value lets anyone forge an admin token: this is the
# single highest-severity secret in the system. Minimum 32 characters.
#   openssl rand -hex 32
IRA_SECRET_KEY=

# Minimum 16 characters. Never reuse a password from another account.
IRA_ADMIN_USERNAME=
IRA_ADMIN_PASSWORD=

# ── Database ─────────────────────────────────────────────────────────────────
# Host must be a private address or a container/service name. PostgreSQL must
# not be reachable from the internet.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Model runtime ────────────────────────────────────────────────────────────
# MUST be a private address or a container/service name. A public host here is
# refused at startup: an unauthenticated inference endpoint on the internet is
# both a data-exfiltration path and an unbounded bill.
OLLAMA_BASE_URL=http://ollama:11434/v1
VLLM_FAST_URL=http://vllm-fast:8001/v1
VLLM_DEEP_URL=http://vllm-deep:8002/v1
VLLM_API_KEY=

# ── Observability ────────────────────────────────────────────────────────────
# json | text. Defaults to json in staging/production.
IRA_LOG_FORMAT=json
IRA_LOG_LEVEL=INFO
IRA_SERVICE_NAME=ira-api
# OpenTelemetry collector. Leave blank to disable.
OTLP_ENDPOINT=

# ── Readiness ────────────────────────────────────────────────────────────────
# When true, /readyz requires a reachable model runtime. Leave false where the
# API is useful without inference — otherwise one degraded subsystem takes the
# whole product out of the load balancer.
IRA_READINESS_REQUIRE_MODEL=false

# ── Timeouts (seconds) ───────────────────────────────────────────────────────
# Defaults live in ira/core/runtime/timeouts.py; override only with a reason.
IRA_API_REQUEST_TIMEOUT=60
IRA_SHUTDOWN_TIMEOUT=25
IRA_MAX_REQUEST_BODY_BYTES=10485760

# ── Build metadata — injected by CI, not set by hand ─────────────────────────
# docker build --build-arg GIT_COMMIT=$(git rev-parse HEAD) \
#              --build-arg BUILD_TIMESTAMP=$(date -u +%Y-%m-%dT%H:%M:%SZ)
GIT_COMMIT=
BUILD_TIMESTAMP=

# ── MUST NOT be set in a cloud deployment ────────────────────────────────────
# DEV_MODE bypasses authentication and the biometric gate for every request.
# Setting it true with IRA_ENVIRONMENT=staging|production is refused at startup.
DEV_MODE=false
