# =============================================================================
# SupraCloud IRA - Environment  (Ollama + Cortex era)
# Copy to .env and fill in every REQUIRED value before starting. NEVER commit .env.
#
# IRA runs NATIVE on Windows (the dev workstation): local Ollama for inference, with the
# Cortex agent gateway out-of-process. Nothing leaves the box.
#
# NOTE (clean rewrite): the old file defined ~12 keys twice (an "L6 overrides"
# block at the bottom). dotenv is last-wins, so those bottom copies were the ones
# actually taking effect. This file has ONE definition per key. The only value
# that differed between the two copies was IRA_DOMAIN (ira.local vs localhost) -
# localhost won and is kept. The dormant vLLM scale-up vars are preserved at the
# very bottom because the cloud upgrade path still uses them.
#
# ASCII separators are used deliberately - the previous file's box-drawing
# characters were mojibake (â”€) from a UTF-8/latin-1 mismatch.
# =============================================================================


# -----------------------------------------------------------------------------
# EDITION (Phase 1)
# Which product this process serves:
#   private (default) = this local-first, single-owner IRA. Unchanged behaviour.
#   cloud             = the multi-tenant SaaS. NOT IMPLEMENTED yet (Phase 2+);
#                       setting it now tightens defaults but serves no traffic.
# Resolved once at startup - never inferred from a request, header or hostname.
# An unrecognised value refuses startup rather than guessing.
# See docs/cloud-transformation/adr/ADR-0001-TWO-EDITIONS.md.
# -----------------------------------------------------------------------------
IRA_EDITION=private


# -----------------------------------------------------------------------------
# REQUIRED SECRETS  —  every value here MUST stay EMPTY in this example file.
# Fill them only in your real .env (never committed; see .gitignore).
# Generate each with:  openssl rand -hex 32
#
# This file is scanned by Gitleaks in CI (.github/workflows/test.yml). A populated
# credential here fails the build — that is deliberate: an example file with a real
# value in it has been published to everyone who can read the repository.
# -----------------------------------------------------------------------------
IRA_SECRET_KEY=
# The owner login must not be owner, system, self_knowledge, meeting or
# technical_library (any case): IRA keeps those names for its own memory, and a
# new install with one of them refuses to start.
IRA_ADMIN_USERNAME=admin                 # the verified OWNER's login (not a secret)
IRA_ADMIN_PASSWORD=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Only used when LLM_BACKEND=vllm (the key-gated GPU path). Unused on Ollama;
# example files must keep credential fields blank.
VLLM_API_KEY=


# -----------------------------------------------------------------------------
# ENGINE: local inference backend
# "ollama" (default) = local native Ollama. "vllm" = the dormant GPU/Docker path.
# Independent of DEV_MODE - on ollama, auth + biometric gates stay ON.
# -----------------------------------------------------------------------------
LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1     # OpenAI-compatible, keep LOCAL

# Tiered models on the 20GB A4500.
#   ollama pull qwen3:8b    (fast / voice - low latency)
#   ollama pull qwen3:14b   (deep / reasoning)
# DECISION FLAG: all three tiers are currently 14B. The "fast" tier is meant to be
# qwen3:8b for low voice latency (see the pull comment above). Left at 14B on
# purpose - flip FAST to qwen3:8b if voice TTFT feels slow. This is a choice, not a bug.
OLLAMA_MODEL_FAST=qwen3:14b
OLLAMA_MODEL_DEEP=qwen3:14b
OLLAMA_MODEL_REASONING=qwen3:14b

# Keep models resident between turns for faster TTFT. start-ira.ps1 also sets
# OLLAMA_FLASH_ATTENTION=1 / OLLAMA_KV_CACHE_TYPE=q8_0 so both fit warm together.
OLLAMA_KEEP_ALIVE=30m

# The context window Ollama runs, in tokens. IRA keeps every request (prompt +
# answer) inside it; past it Ollama silently drops the start of the prompt,
# question included. Unset, IRA assumes 4096, Ollama's default below 24 GiB of
# VRAM. Set it to change both: start-ira.sh passes .env to the `ollama serve` it
# starts. An Ollama started another way must be given the same value. More
# costs memory: qwen3:4b holds about 0.6 GB of KV cache at 4096, 1.15 GB at 8192.
# OLLAMA_CONTEXT_LENGTH=4096

# Local vision-language model (Phase 3).  ollama pull qwen2.5vl
OLLAMA_VISION_MODEL=qwen2.5vl

# Seconds to wait for the local model's answer. A non-streamed answer sends
# nothing until it is complete, so this bounds the whole answer. 120 suits a
# GPU; setup-native.sh and setup-windows.ps1 write 600 when they find no GPU.
# A request that runs out of time is reported, never sent to the model again.
OLLAMA_READ_TIMEOUT_S=120
# Seconds a non-streamed chat answer (POST /api/v1/chat) may take in all; past
# it the API answers 504 "model_timeout". 840 is one minute inside the web
# app's 15-minute proxy limit, after which the caller would get an empty 500.
IRA_CHAT_TIMEOUT_S=840


# -----------------------------------------------------------------------------
# CORTEX engine (agent engine, reached via the `cortex -z` subprocess)
# When true, IRA routes chat AND voice through Cortex via the bridge. Cortex adds
# a hop, so for LOWEST voice latency keep this false (direct Ollama, qwen3:8b);
# both engines return real replies. (IRA_CORTEX_URL/KEY are back-compat only -
# 0.15.2 has no HTTP gateway; the bridge shells out to `cortex -z`.)
# -----------------------------------------------------------------------------
# false matches the code default (ira/config.py reads IRA_USE_CORTEX defaulting to
# false) and the "false (DEFAULT)" note in ira/config/cortex.env.example. It is also
# the setting that works on a fresh install: the bridge shells out to a `cortex -z`
# binary, so opting in before Cortex is installed on the host breaks the chat path.
# Set true once Cortex is installed and configured against local Ollama.
IRA_USE_CORTEX=false
# MUST stay local (127.0.0.1/localhost) - a non-local URL is warned about loudly
# at startup because prompts would leave the box through a remote gateway.
IRA_CORTEX_URL=http://127.0.0.1:8642/v1
# MUST equal Cortex' API_SERVER_KEY on the other side. Generate: openssl rand -hex 32.
# Leave EMPTY here — hermes-agent 0.15.2 has no key-gated gateway, so the subprocess
# bridge does not read it at all (see ira/config/cortex.env.example).
IRA_CORTEX_KEY=
IRA_CORTEX_MODEL=hermes-agent
IRA_CORTEX_TIMEOUT=300


# -----------------------------------------------------------------------------
# SOVEREIGN WEB RESEARCH (Phase 3B) - self-hosted backends only
# Keep both LOCAL/self-hosted; non-local values are warned about at startup so
# research queries can't leave the box. Optional - research fails soft if down.
# -----------------------------------------------------------------------------
SEARXNG_URL=http://localhost:8888        # self-hosted SearXNG (search)
CRAWL4AI_URL=http://localhost:11235      # self-hosted Crawl4AI (clean web reader)
# Local-first default: web search is OFF. Set true to opt in to external search.
# (A7: kept OFF for a clean L1-L9 baseline boot test. See ACCURACY_LAYER.md.)
# Matches the code default in ira/config.py (web_search_enabled = False).
WEB_SEARCH_ENABLED=false
# Accuracy lever, also OFF for the first boot test. Models are pre-downloaded, so
# flipping this true after the boot passes is instant. See ACCURACY_LAYER.md.
RERANKER_ENABLED=false


# -----------------------------------------------------------------------------
# PRIVACY / SOVEREIGNTY  (Personal v1 defaults - everything local)
# -----------------------------------------------------------------------------
# Master switch for any external (cloud) API call. false = hard-off: IRA never
# calls out even if a cloud key is configured below. Flip to true ONLY if you
# deliberately want a cloud provider in the loop.
IRA_ALLOW_EXTERNAL_API=false
# When external APIs are allowed, still require explicit per-request consent.
IRA_REQUIRE_API_CONSENT=true
# local_only  = never offer an external model at all (strictest).
# local_first = prefer local but offer external for very hard tasks (consent-gated).
#               This is the code default in ira/config.py and in
#               ira/config/model_selection.env.example.
# external_ok = allow external routing when it wins (still consent-gated).
# Kept at local_only here because this example ships the strictest local-first
# posture; the code default is local_first. Either is safe — local_only is stricter.
IRA_PRIVACY_MODE=local_only
# Model-selection profile (see ira/config/model_profiles.yaml). balanced_local
# picks local Ollama tiers only.
IRA_MODEL_PROFILE=balanced_local
# Inference capacity record on the Trust Console (ira/reasoning/capacity.py):
# memory, threads and accelerator are always read; the short generation probe
# that measures tokens/s loads one model through Ollama, so it is OFF unless
# set. Informational only: it changes no routing.
# IRA_CAPACITY_PROBE=1
# IRA_CAPACITY_PROBE_MODEL=qwen3:4b
# Run mode: standard (daily use) | portable_demo (USB guard-railed demo).
# Portable SSD mode is deferred until Personal v1 is done - leave standard.
IRA_MODE=standard
# ONNX Runtime, which voice transcription and the wake word load, reports usage
# to Microsoft (mobile.events.data.microsoft.com) as soon as it is imported,
# unless this is set before it loads. 1 keeps that on this machine. IRA and the
# start scripts also set it when it is unset or blank
# (ira/core/runtime/vendor_telemetry.py); it is written here so the choice is
# visible.
ORT_DISABLE_TELEMETRY=1
# Hugging Face: setup downloads the memory models, and at start-up IRA loads
# them from this machine's cache, reaching huggingface.co only for one that is
# not cached yet (ira/core/models/artefacts.py, load_cached_first). To forbid
# every Hugging Face download, uncomment the next line. A model that is not
# cached then fails to load instead, including the voice models (speech-to-text,
# the voice print) that are downloaded on first use.
# HF_HUB_OFFLINE=1


# -----------------------------------------------------------------------------
# OWNER / BIOMETRIC GATE
# -----------------------------------------------------------------------------
# MUST match the identity you enrolled voice biometrics under. Set this in your
# real .env — left blank here so the example carries no personal data. Startup
# logs a CONFIG WARNING while it is unset (ira/app/lifespan.py).
OWNER_NAME=
BIOMETRIC_THRESHOLD=0.75                  # cosine-similarity floor for voice auth (fail-closed below)


# -----------------------------------------------------------------------------
# ARMORY VAULT (encrypted, owner-gated security-tool cabinet)  — OFF by default
# -----------------------------------------------------------------------------
# The Armory houses cybersecurity tools (Kali toolchain, Tor, Nmap, …) sealed
# with AES-256-GCM behind a Master Key only you know. Run
#   python -m scripts.setup_vault
# to create the vault and set the key; setup writes ARMORY_MASTER_KEY_HASH below
# (a salted PBKDF2 verifier — NEVER the plaintext key). External egress by Armory
# tools still obeys IRA_ALLOW_EXTERNAL_API above (local/private targets only when
# it is false). Only scan hosts you own or are authorized in writing to test.
ARMORY_ENABLED=false
ARMORY_VAULT_DIR=data/armory              # holds the sealed vault (git-ignored)
# set by scripts/setup_vault.py — do not edit by hand
ARMORY_MASTER_KEY_HASH=
ARMORY_SESSION_TTL_SECONDS=300            # idle auto-lock (seconds); also locks after each task
# Execution backend. Docker is NOT required: "auto" prefers Docker, then firejail,
# then bubblewrap (both cut the network at the kernel via Linux namespaces — the
# killswitch without a daemon). "local" runs unsandboxed on the host and only works
# if ARMORY_ALLOW_UNSANDBOXED=true as well.
ARMORY_EXECUTION_BACKEND=auto             # auto | docker | firejail | bubblewrap | local
ARMORY_DOCKER_ENABLED=true                # false = never use the Docker backend
ARMORY_ALLOW_UNSANDBOXED=false            # true = permit the no-isolation "local" backend (not recommended)
# High-risk tools (hydra, metasploit, …) require a valid TOTP 2FA code — the same
# authenticator second factor as login (enrol at POST /auth/totp/enroll). Set false
# to fall back to a plain explicit-confirmation approval (not recommended).
ARMORY_REQUIRE_TOTP_FOR_HIGH_RISK=true
# Master-Key brute-force protection: after this many failed unlock attempts the
# Armory refuses further attempts for the lockout window (seconds).
ARMORY_MAX_UNLOCK_ATTEMPTS=5
ARMORY_UNLOCK_LOCKOUT_SECONDS=300


# -----------------------------------------------------------------------------
# Database / cache hosts (native = localhost)
# NOTE: "jarvis"/"jarvis_db" are legacy internal identifiers kept so existing data
# volumes keep working. On a FRESH install you may use ira / ira_db instead - just
# keep .env, the running Postgres role, and the database name in sync.
# -----------------------------------------------------------------------------
POSTGRES_USER=jarvis
POSTGRES_DB=jarvis_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_HOST=localhost
REDIS_PORT=6379


# -----------------------------------------------------------------------------
# Embeddings (memory)
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DEVICE=cpu                       # keep VRAM free for the 14B


# -----------------------------------------------------------------------------
# Voice (browser-native - the DEFAULT working path; no LiveKit needed)
# -----------------------------------------------------------------------------
# Backend TTS/STT engines (read by ira-api):
IRA_VOICE_ENGINE=supertonic                # supertonic (on-device, female) | kokoro (legacy)
IRA_VOICE=F1                               # Supertonic F1-F5 (female) / M1-M5 (male); Kokoro: af_bella
IRA_TTS_STEPS=6                            # synthesis steps - low = faster first audio
# Local STT checkpoint. Leave EMPTY to choose by hardware: small (CPU default),
# base on IRA_MODEL_PROFILE=low_resource or fewer than 4 CPUs. Pinned names only:
# base | small | distil-large-v3 (English, ~4x slower than small on CPU) |
# large-v3 (multilingual, slowest) - or a local model directory.
# No inline comment on the value line: start-ira.sh/.ps1 export it verbatim.
WHISPER_MODEL=
WHISPER_VAD_MIN_SILENCE_MS=700            # higher = don't clip on a brief pause (accented/partial speech)
WHISPER_VAD_MIN_SPEECH_MS=200
# Native Indic TTS for Tamil/Telugu/Kannada/Malayalam (Hindi stays on Supertonic).
# Fail-soft: if the model isn't installed, those languages use Supertonic's 'na'.
IRA_INDIC_TTS_ENGINE=indic-parler          # indic-parler | none
IRA_INDIC_TTS_MODEL=ai4bharat/indic-parler-tts   # HF id or local path
# IRA_INDIC_TTS_VOICE=A female speaker delivers clear, natural speech.
#
# Frontend browser voice loop - Next.js only exposes NEXT_PUBLIC_* to the browser:
NEXT_PUBLIC_VOICE_TRANSPORT=browser        # browser (default) | livekit (legacy)
NEXT_PUBLIC_VOICE_ACTIVATION=clap          # clap (on-device) | wakeword (Chrome's Web Speech listens continuously: audio leaves the machine, NOT private - shows a badge)
NEXT_PUBLIC_WAKE_WORD=hey ira              # trigger phrase for wakeword mode
NEXT_PUBLIC_VOICE_STT=whisper              # whisper (sovereign, local) | webspeech (fast, NOT private - shows a badge)
NEXT_PUBLIC_PWA=true                       # install/offline service worker (production only); set false to disable
#
# IRA UI mode — avatar shells (docs/DIGITAL_HUMAN_AVATAR.md, docs/HOLOGRAPHIC_INTERFACE.md):
#   classic       the accessible 2D workspace (default; always available)
#   portrait      the approved IRA reference portrait with subtle depth/motion (not lip-synced)
#   holographic   the procedural green "transmission" avatar
#   digital-human a realistic rigged GLB (PBR skin/eyes/hair) — falls back to portrait if absent
#   auto          best available: digital-human → portrait → holographic → classic
NEXT_PUBLIC_IRA_UI_MODE=classic            # classic (default) | portrait | holographic | digital-human | auto
NEXT_PUBLIC_IRA_AVATAR_URL=/avatar/ira-head.glb            # rigged desktop GLB (install locally; never committed)
# NEXT_PUBLIC_IRA_AVATAR_MOBILE_URL=/avatar/ira-head-mobile.glb   # optional lower-poly mobile model
NEXT_PUBLIC_IRA_REFERENCE_IMAGE=/avatar/ira-reference.png   # approved canonical identity portrait (committed)
NEXT_PUBLIC_IRA_AVATAR_MANIFEST=/avatar/ira-avatar-manifest.json   # orientation/camera/effects for the model
NEXT_PUBLIC_IRA_DIGITAL_HUMAN_EFFECTS=subtle               # subtle (default) — restrained rim light, no face glitch
IRA_LIPSYNC_ALIGN=true                     # whisper forced-alignment pass on /voice/say timings (false = fast estimation)

IRA_VOICE_OUTPUT=local
# Always-on wake-word listener at boot (host microphone; ira/voice/wakeword.py).
# Off, matching the code default: listening from startup must be the owner's
# choice, not the template's. The owner's runtime toggle is Wake Mode in Voice Setup.
IRA_WAKEWORD_ENABLED=false
# Realtime brain (ambient self-thought stream, /api/v1/brain). Experimental and
# always-on once enabled, so it is an explicit opt-in. false matches the code
# default in ira/api/routes/brain.py (brain_enabled() defaults to false).
IRA_BRAIN_ENABLED=false


# -----------------------------------------------------------------------------
# Voice (LiveKit - LEGACY; only when NEXT_PUBLIC_VOICE_TRANSPORT=livekit)
# Harmless while transport=browser. Fill only if you switch to LiveKit.
# -----------------------------------------------------------------------------
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_ROOM_NAME=ira-voice
LIVEKIT_PUBLIC_URL=ws://localhost:7880
# Signed JWT (sub=ira-voice) the LiveKit voice agent uses to call ira-api.
IRA_VOICE_API_TOKEN=


# -----------------------------------------------------------------------------
# Real-time sessions (Phase 6) — OFF by default, and it stays off unless
# every value below is set.
#
# Leave IRA_REALTIME_PROVIDER unset (or "none") and voice runs entirely on the
# device, exactly as it does today: nothing is sent anywhere. This is the
# correct configuration for IRA Private and it is not a degraded mode.
#
# Setting the provider WITHOUT all three credentials does not half-enable it.
# build_transport() returns the refusal and sessions fall to the text rung —
# see docs/cloud-transformation/adr/ADR-0005-PROVIDER-NEUTRAL-REALTIME.md.
#
# What enabling this means, plainly: during a live session the user's microphone
# audio is carried by the provider named here, and that provider can hear it.
# The media is encrypted in transit but NOT end-to-end — the SFU decrypts it to
# route it. IRA does not record the audio and stores no transcript; that is
# enforced by the schema (027_realtime.sql), not by convention.
# -----------------------------------------------------------------------------
# none (default) | livekit
IRA_REALTIME_PROVIDER=none
# Coarse, enumerated: unknown | eu | uk | us | apac | other. Used to tell the
# user which jurisdiction their audio crossed, so a free-form value is refused.
IRA_REALTIME_REGION=unknown


# -----------------------------------------------------------------------------
# Connectors (Phase 7) — Gmail, Calendar, Drive. OFF by default.
#
# BOTH the OAuth client and the encryption key are required. With either
# missing, GET /api/v1/connectors reports available:false with the reason, and
# no account can be connected — a flow that ends by failing to store the token
# wastes the user's consent and leaves a live grant at Google IRA cannot see.
#
# What IRA can do once connected: READ your mail, calendar and documents, and
# save DRAFTS you send yourself. It cannot send email, change your calendar or
# modify files — those scopes are on a refusal list and are never requested.
# See docs/cloud-transformation/CONNECTOR_MODEL.md.
# -----------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must exactly match a redirect URI registered on the Google client.
GOOGLE_OAUTH_REDIRECT_URI=

# Encrypts stored refresh tokens (AES-256-GCM). 32 random bytes, base64:
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
#
# DELIBERATELY SEPARATE from IRA_SECRET_KEY. Reusing a signing key for
# encryption widens the blast radius of either leaking, and rotating one
# silently breaks the other. No key is ever generated on the fly: that would
# make the first run work and every later run fail to decrypt, which presents
# to users as "Google disconnected me".
#
# NOT a KMS. An attacker with the database AND this environment gets the
# tokens; the database alone does not. A managed KMS is Phase 8.
IRA_CONNECTOR_ENCRYPTION_KEY=
# Labels which key a row was encrypted under, so a future rotation can find its
# work. Unset => "default".
IRA_CONNECTOR_ENCRYPTION_KEY_ID=
# The URL is reused from the LiveKit block above. LIVEKIT_PUBLIC_URL is the
# BROWSER-facing address and is preferred; LIVEKIT_URL (the internal one, e.g.
# ws://livekit:7880) is accepted as a fallback for single-host installs where
# the two coincide. Handing a browser the internal address produces a failure
# that looks like a provider outage on a correctly configured deployment.


# -----------------------------------------------------------------------------
# Coding agent (Aider - sovereign by default, owner-gated, branch-only)
# Voice/text coding ("fix the bug in x.py") runs Aider on a fresh branch.
# Experimental and OFF by default: its detector also matches everyday requests
# ("find the file I saved yesterday"), each of which starts a coding task.
# Install on the box: pipx install aider-chat ; ollama pull qwen2.5-coder:14b
# -----------------------------------------------------------------------------
IRA_CODING_AGENT_ENABLED=false             # true = coding asks in chat run Aider
CODER_BACKEND=local                        # local (Ollama coder) | cloud (logged)
CODER_MODEL=qwen2.5-coder:14b              # fits 20GB. 32B only on 24GB+ GPU
# aider alias; required for CODER_BACKEND=cloud (no default)
CODER_CLOUD_MODEL=
CODING_REQUIRE_OWNER=true                  # refuse coding for non-owner when biometrics are on
# Comma-separated absolute repo paths the coding agent may edit (blank = any).
# Set this in your real .env; left blank here so the example leaks no host paths.
CODER_ALLOWED_REPOS=
# CODER_REPO_PATH=                         # default repo to edit (blank = the IRA package dir)
# CODER_TEST_CMD=pytest -q                 # test command run after editing


# -----------------------------------------------------------------------------
# Architect (self-modification: proposes, writes and applies changes to IRA)
# Experimental and OFF by default. Off: the chat triggers reach normal chat, the
# /architect propose, implement and apply routes answer 503, and the 12-hour
# background proposal cycle does not run. Applying still needs `architect apply`.
# -----------------------------------------------------------------------------
IRA_ARCHITECT_ENABLED=false


# -----------------------------------------------------------------------------
# Strategy mode (bounded deliberation - ranked, honest option analysis)
# Triggered only by explicit strategic asks ("should I...", "best strategy..."); multi-call.
# -----------------------------------------------------------------------------
STRATEGY_BRANCHES=4                        # candidate options to weigh
STRATEGY_DEPTH=1                           # lookahead steps (hard-capped at 2)
STRATEGY_SELF_CONSISTENCY=1                # >1 = sample N times and average the estimates
STRATEGY_DEEP_SYNTHESIS=true               # use the deep (qwen3:14b) tier for the analysis
STRATEGY_CALIBRATION_ENABLED=true          # Phase 6: calibrate estimates against owner's recorded outcomes


# -----------------------------------------------------------------------------
# Identity / domain
# -----------------------------------------------------------------------------
# localhost = native local boot (current, was the effective value). Use ira.local
# only if you front IRA with that hostname (Docker/reverse-proxy setup).
IRA_DOMAIN=localhost
# Ports used by start-ira.sh / start-ira.ps1 (change only on conflicts).
IRA_API_PORT=8000
FRONTEND_PORT=3000
# Phone access over Tailscale Serve (HTTPS - required for mobile mic). Set to your
# box's MagicDNS host so CORS allows the phone's origin. See TAILSCALE_SETUP.md.
# e.g. shadow.tailnet-name.ts.net
IRA_TS_HOST=
# Browser API base - leave BLANK for same-origin (tailscale serve path-routes /api).
# Set only if the API is served from a different host than the frontend.
NEXT_PUBLIC_API_BASE=
# Hosts /billing will send a browser to for checkout. Cloud edition only; the
# Private edition has no billing page. Blank = the built-in Stripe hosts.
# The checkout address comes from the payment provider by way of our API, so it
# is not ours to trust: the page opens it only if the host is on this list or is
# our own origin, and shows a refusal otherwise. Set this ONLY when you run a
# provider other than Stripe, and list exactly its checkout hosts - a wildcard,
# or a host you do not control, is an open redirect out of a signed-in session.
NEXT_PUBLIC_BILLING_CHECKOUT_HOSTS=
# Author email for Architect-apply commits. Set in your real .env — blank here so
# the example carries no personal contact data.
IRA_GIT_AUTHOR_EMAIL=


# -----------------------------------------------------------------------------
# Proactive agent
# DECISION FLAG: timezone is Asia/Kolkata. You're London-based - if the morning
# briefing should fire at 8am *your* local time, set Europe/London (or adjust the
# UTC hour). Left as Kolkata in case that's intentional.
# -----------------------------------------------------------------------------
BRIEFING_HOUR_UTC=8
BRIEFING_TIMEZONE=Europe/London
# Background jobs the worker runs (start-ira.sh starts it; ira/worker/jobs.py).
# Empty: reminder_check, model_perf_retention, token_version_retention, which
# call no model. "none": no worker. "all": every job. Or a comma list, e.g.
# reminder_check,morning_briefing. memory_retention deletes Memory Vault
# entries older than 90 days; see docs/operations/WORKER_JOBS_2026-10-23.md.
IRA_WORKER_JOBS=


# -----------------------------------------------------------------------------
# Actions (all fail soft when unset - see /api/v1/actions)
# -----------------------------------------------------------------------------
# Calendar (Cal.com)
CALCOM_API_KEY=
CALCOM_API_URL=https://api.cal.com
# Email-with-approval (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TO=
# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# -----------------------------------------------------------------------------
# P5.2 Canary tokens / tripwires
# Generate with: openssl rand -hex 32. Leave blank to disable (all optional).
# -----------------------------------------------------------------------------
# A canary only works while it is SECRET - a published canary is a canary an
# attacker knows to avoid. Both MUST stay empty here and be set in your real .env.
# IRA_CANARY_TOKEN: a fake bearer token - any API request using it fires CRITICAL.
IRA_CANARY_TOKEN=
# IRA_CANARY_USERNAME: a ghost login name - any login attempt for it fires CRITICAL.
IRA_CANARY_USERNAME=


# -----------------------------------------------------------------------------
# Webhooks / business
# -----------------------------------------------------------------------------
# openssl rand -hex 32
WEBHOOK_SECRET=
HOT_LEAD_KEYWORDS=urgent,asap,immediately,enterprise,critical
HOT_LEAD_BUDGETS=enterprise,250k+,100k-250k


# -----------------------------------------------------------------------------
# Optional integrations (career / media / X) - all blank = disabled
# -----------------------------------------------------------------------------
GITHUB_TOKEN=
APIFY_API_TOKEN=
TWITTER_BEARER_TOKEN=
X_FALLBACK_API_URL=https://api.twitterapi.io
X_FALLBACK_API_KEY=
# Local-first default: sd_webui/comfyui run on-box. "replicate" is cloud opt-in
# and also needs REPLICATE_API_TOKEN before any request is made.
IMAGE_GEN_PROVIDER=sd_webui
REPLICATE_API_TOKEN=


# -----------------------------------------------------------------------------
# Browser Agent (flight search / web lookup) - read-only Playwright browsing.
# Requires: pip install playwright && playwright install chromium
# -----------------------------------------------------------------------------
BROWSER_AGENT_ENABLED=true
BROWSER_TASK_TIMEOUT_S=60            # hard ceiling per browser task (seconds)
BROWSER_HEADLESS=true                # false = visible Chromium for debugging


# -----------------------------------------------------------------------------
# Backup
# -----------------------------------------------------------------------------
BACKUP_DIR=/backups
BACKUP_KEEP=7


# -----------------------------------------------------------------------------
# Observability (OpenTelemetry) - blank = disabled
# -----------------------------------------------------------------------------
OTLP_ENDPOINT=
OTLP_HEADERS=


# -----------------------------------------------------------------------------
# Auth token lifetimes (P2.1)
# -----------------------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=30       # access token lifetime; shorter = smaller stolen-token window
REFRESH_TOKEN_EXPIRE_DAYS=7          # refresh token lifetime; used to obtain new access tokens. 1-7: a longer value is refused at start (migration 096)


# -----------------------------------------------------------------------------
# DEV MODE - local only, NEVER in production
# DEV_MODE=true bypasses auth + biometrics and auto-authenticates as admin.
# NOT required for local Ollama - LLM_BACKEND=ollama already runs locally with the
# gates ON. Leave false unless you are deliberately disabling security.
# false matches the code default in ira/config.py (dev_mode = False).
#
# IRA_DOMAIN is NOT repeated here - it is defined once, in the "Identity / domain"
# section above. The old duplicate at the bottom of this file made the effective
# value depend on dotenv last-wins ordering.
# -----------------------------------------------------------------------------
DEV_MODE=false
API_BIND_HOST=127.0.0.1

# =============================================================================
# LEGACY / DORMANT - vLLM GPU path (only for the 8xH100 scale-up). Not used on the
# dev workstation. Kept because the cloud upgrade flips LLM_BACKEND=vllm and sets these.
# The old duplicate "L6 overrides" that lived here have been merged upward; only
# the genuinely-dormant vLLM vars remain.
# =============================================================================
# VLLM_FAST_URL / VLLM_DEEP_URL / VLLM_REASONING_URL / VLLM_VISION_URL ...
VLLM_FAST_MODEL=qwen3-fast
VLLM_DEEP_MODEL=qwen3-deep
VLLM_REASONING_URL=
VLLM_REASONING_MODEL=qwen3-reasoning
VLLM_VISION_URL=
VLLM_VISION_MODEL=qwen3-vl
HF_TOKEN=
