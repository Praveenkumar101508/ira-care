# =============================================================================
# IRA — test environment template
#
#   cp .env.test.example .env.test
#
# Placeholders are ACCEPTABLE here and nowhere else: `IRA_ENVIRONMENT=test` is
# not production-like, so the startup validation in
# ira/core/runtime/environment.py is a no-op. That is the point — a test suite
# must not need real credentials, and requiring them would push somebody to put
# production values in CI.
#
# Nothing here is a secret. Nothing here may be reused outside a test.
# =============================================================================

IRA_ENVIRONMENT=test
IRA_EDITION=private

# Placeholder credentials — these exact values appear in .github/workflows.
IRA_SECRET_KEY=ci-test-secret-key
IRA_ADMIN_USERNAME=admin
IRA_ADMIN_PASSWORD=ci-test-password
POSTGRES_PASSWORD=ci-test
REDIS_PASSWORD=ci-test
VLLM_API_KEY=ci-test

# Bypasses auth globally. Acceptable ONLY in test/development, and refused at
# startup in staging/production.
DEV_MODE=true

IRA_DOMAIN=localhost
IRA_LOG_FORMAT=text
IRA_LOG_LEVEL=WARNING

# ── Database-backed suites ───────────────────────────────────────────────────
# Without these, 365 of 3929 tests skip — including the whole tenancy suite,
# which is the load-bearing one for the cloud product. The role MUST NOT be a
# superuser: a superuser bypasses RLS entirely and every isolation assertion
# would pass while proving nothing. The suite asserts `rolsuper = f` first.
IRA_TEST_DATABASE_DSN=postgresql://ira_app:ira_app@127.0.0.1:5432/iratest

# A second, PRIVILEGED DSN. The backup-restore suite must CREATE DATABASE, and
# the application role must not be able to — so it cannot borrow those
# credentials.
IRA_TEST_ADMIN_DSN=postgresql://postgres@127.0.0.1:5432/iratest

# Opt-in for tests that terminate every database backend and put PostgreSQL
# into crash recovery. Set ONLY against a database you are willing to destroy.
# IRA_TEST_ALLOW_DESTRUCTIVE=1
