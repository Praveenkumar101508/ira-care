# IRA API — portable demo image (CPU-only, no GPU/vLLM).
# Reasoning runs on the local Ollama service; embeddings on CPU.
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    EMBEDDING_DEVICE=cpu

WORKDIR /app

# System deps kept minimal; build tools only for wheels that need them.
#
# `apt-get upgrade` is here for the same reason the pip upgrade below is, and
# the container gate states the rule in its own message: *"Fixable findings are
# never baselined — take the fix, or rebase the image onto a tag that carries
# it."*
#
# The base tag is rebuilt on Debian's schedule, not on ours, so between two
# rebuilds its packages accumulate published security fixes that the image does
# not have. `util-linux CVE-2026-53615` (fixed in 2.41.5-0+deb13u1) is the one
# that turned the gate red; there were nine such findings and every one had a
# fix available from the distribution at build time.
#
# This does NOT touch the many findings with no published fix. Those are what
# the gate's ratchet is for, and taking an upgrade cannot close them.
RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && apt-get install -y --no-install-recommends build-essential curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./

# P16-R5. The base image's pip toolchain carries two HIGH advisories that DO
# have fixes, found by the first trivy scan of this image:
#
#   wheel 0.45.1           CVE-2026-24049  fixed in 0.46.2
#   jaraco.context 5.3.0   CVE-2026-23949  fixed in 6.1.0  (vendored by setuptools)
#
# A finding with a published fix is not baselined — it is fixed. Upgraded
# BEFORE the project's own install so the newer wheel is what builds everything
# that follows.
#
# setuptools is capped below 82 because `torch` requires `setuptools<82`, and
# requirements.txt installs torch. Without the cap pip would resolve a newer
# setuptools and then have to walk it back.
RUN pip install --upgrade "wheel>=0.46.2" "setuptools>=80,<82"
RUN pip install -r requirements.txt

# P16-R5, FINDING AP. This image ran as ROOT. Every other Dockerfile in this
# repository creates an unprivileged user and switches to it —
# `voice/Dockerfile` and both `future-scale` images do — and this one was
# missed. Found by checkov (CKV_DOCKER_3) on the first run of the IaC gate,
# after six batches of the container position being recorded as UNKNOWN.
#
# The uid is fixed at 1000 to match `future-scale/docker/Dockerfile`, so a
# bind-mounted volume written by one image is readable by the other rather than
# landing with a uid nothing else recognises.
#
# `--chown` on the COPY, not a `chown -R` afterwards: a recursive chown on a
# copied tree duplicates every file into a new layer.
#
# /app itself is chowned too, and that is not tidiness. `COPY --chown` sets the
# ownership of the COPIED FILES, not of the WORKDIR that was created earlier by
# root — so the directory would stay root-owned and unwritable. The application
# writes inside it at runtime (`utils/career_tools.py` creates
# `tailored_resumes/`), and dropping to a non-root user without this turns a
# working feature into a permission error. The chown is cheap here because /app
# holds only requirements.txt at this point.
RUN useradd --create-home --shell /bin/bash --uid 1000 ira \
    && chown ira:ira /app
COPY --chown=ira:ira . .
USER ira

EXPOSE 8000

# Bind 0.0.0.0 inside the container so the published 127.0.0.1:8000 mapping works.
# Exposure is constrained to host-loopback by docker-compose.portable.yml.
HEALTHCHECK --interval=10s --timeout=5s --retries=12 \
    CMD curl -fsS http://127.0.0.1:8000/health || exit 1

CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
