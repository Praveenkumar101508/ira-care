{
  "schema_version": 1,
  "description": "Armory Vault tool manifest. Each entry is a security tool the Armory agent can run inside an ephemeral, network-restricted sandbox. Placeholders in {curly braces} are filled only from validated, whitelisted arguments. Target placeholders ({target}, {url}, {host}, {rhost}, {rhosts}) are checked against whitelist.txt before a tool runs. Only test systems you own or are authorized in writing to assess.",
  "tools": [
    { "id": "nmap_scan",         "category": "recon",         "image": "kali", "cmd": "nmap -sV -Pn {target}",                                             "risk": "low",    "network": "tor",  "description": "Service/version scan of a single authorized host." },
    { "id": "nmap_quick",        "category": "recon",         "image": "kali", "cmd": "nmap -T4 -F -Pn {target}",                                          "risk": "low",    "network": "tor",  "description": "Fast top-100-port sweep." },
    { "id": "nmap_full",         "category": "recon",         "image": "kali", "cmd": "nmap -p- -T4 -Pn {target}",                                         "risk": "medium", "network": "tor",  "description": "All 65535 TCP ports." },
    { "id": "nmap_scripts",      "category": "recon",         "image": "kali", "cmd": "nmap -sC -sV -Pn {target}",                                         "risk": "medium", "network": "tor",  "description": "Default NSE script scan." },
    { "id": "nmap_udp",          "category": "recon",         "image": "kali", "cmd": "nmap -sU --top-ports 50 -Pn {target}",                              "risk": "medium", "network": "tor",  "description": "Top-50 UDP port scan." },
    { "id": "nmap_os",           "category": "recon",         "image": "kali", "cmd": "nmap -O -Pn {target}",                                              "risk": "medium", "network": "tor",  "description": "OS fingerprinting." },
    { "id": "nmap_vuln",         "category": "recon",         "image": "kali", "cmd": "nmap --script vuln -Pn {target}",                                   "risk": "medium", "network": "tor",  "description": "NSE vulnerability scripts." },
    { "id": "masscan",           "category": "recon",         "image": "kali", "cmd": "masscan {target} -p1-65535 --rate 1000",                            "risk": "medium", "network": "tor",  "description": "High-speed full port sweep." },
    { "id": "traceroute",        "category": "recon",         "image": "kali", "cmd": "traceroute {target}",                                               "risk": "low",    "network": "tor",  "description": "Network path trace." },
    { "id": "fping",             "category": "recon",         "image": "kali", "cmd": "fping -c 3 {target}",                                               "risk": "low",    "network": "tor",  "description": "ICMP reachability check." },
    { "id": "arp_scan",          "category": "recon",         "image": "kali", "cmd": "arp-scan {target}",                                                 "risk": "medium", "network": "tor",  "description": "ARP host discovery on a subnet." },
