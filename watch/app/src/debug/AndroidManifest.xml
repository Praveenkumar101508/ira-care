<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets the watch reach a development server over plain HTTP at the
     emulator's host address (see res/xml/network_security_config.xml). Release builds have no
     such file and keep Android's default, which refuses cleartext traffic. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
