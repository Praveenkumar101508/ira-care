<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing the watch holds is backed up or moved to another device: the pairing token and the
     person's readings and urgent events stay on this watch only (the Keystore key would not
     travel with them anyway). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
